<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="@drawable/card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="14sp" android:paddingEnd="6dp"/>
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="Завантаження…"
            android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold"/>
        <TextView android:id="@+id/group" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/until" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textColor="@color/sub" android:textSize="13sp"/>
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginTop="4dp" android:scaleType="fitCenter" android:contentDescription="Графік на сьогодні"/>
    <TextView android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textColor="@color/sub" android:textSize="11sp"/>
</LinearLayout>
