<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/icon" android:layout_width="40dp" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="26sp" android:textColor="@color/text"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/sub" android:textSize="12sp"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="17sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:scaleType="fitXY" android:contentDescription="Графік на сьогодні"/>
</LinearLayout>
